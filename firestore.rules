rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════
    // RÈGLES ARVEXA SCHOOL
    // ═══════════════════════════════════════════════════════════════

    // ─── Profil utilisateur + sous-collections ───────────────────
    match /users/{userId} {

      // Lecture / création du profil : propriétaire uniquement
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;

      // Update : propriétaire, SAUF champs sensibles
      allow update: if request.auth != null
        && request.auth.uid == userId
        && !(request.resource.data.diff(resource.data).affectedKeys()
              .hasAny([
                'premium',
                'isUnlocked',
                'hasDeposited',
                'role',
                'accountStatus'
              ]));

      // Suppression interdite côté client
      allow delete: if false;

      // ─── examResults : examens blancs ─────────────────────────
      match /examResults/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if false;
      }

      // ─── revisionSessions : Réviseur ──────────────────────────
      match /revisionSessions/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if false;
      }

      // ─── grades : notes manuelles ─────────────────────────────
      match /grades/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // ─── notifications : lecture + marquer comme lu ───────────
      match /notifications/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow create, delete: if false;
      }

      // ─── examCache, examUsage, reviseurUsage (serveur only) ───
      match /examCache/{docId} {
        allow read, write: if false;
      }
      match /examUsage/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
      match /reviseurUsage/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // ─── Session d'examen / révision active ───────────────────
      match /activeExam/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /activeRevision/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // ─── Favoris ──────────────────────────────────────────────
      match /favorites/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ─── Sujets (cours) : lecture pour tous les connectés ────────
    match /subjects/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ─── Avis utilisateurs ────────────────────────────────────────
    match /avis/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // ─── Groupes (chat) ───────────────────────────────────────────
    match /groups/{groupId}/{document=**} {
      allow read, write: if request.auth != null;
    }

    // ─── Notifications admin (écrites par admin-89) ───────────────
    match /admin_notifications/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
