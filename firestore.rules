rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════
    // RÈGLES ARVEXA SCHOOL
    // Version : 2026-11-09 (v6 — classement hebdo + streak borné + collections serveur)
    // Changements majeurs :
    //  - NOUVEAU v6 : leaderboard/{week}/entries/{uid} — classement
    //    hebdomadaire OPT-IN (P2 rétention) : lecture connectés, écriture de
    //    SES SEULES données, champs strictement bornés, retrait = soi-même.
    //  - NOUVEAU v6 : users/{uid}/progression/streak borné (compteurs ≤ 730,
    //    champs exacts) — la série 🔥 devient multi-appareils (P2).
    //  - NOUVEAU v6 : ai_cache + examPool explicitement FERMÉS au client
    //    (écrits uniquement par le serveur — cache IA partagé + pool d'examens).
    //  - NOUVEAU v5 : sous-collection users/{uid}/analytics_daily/{date}
    //    (+ results) — le tracker client analytics.js v3 tombait en
    //    permission-denied (refus par défaut : aucune règle ne couvrait ce
    //    chemin) depuis le durcissement v3 → page admin Analytics vide.
    //    Lecture/écriture propriétaire, champs strictement bornés.
    //  - NOUVEAU v4 : collection positions/{uid} — partage VOLONTAIRE de
    //    la position (ville + distance approximative, jamais l'adresse)
    //    pour se trouver entre camarades ; lecture connectés, écriture
    //    propriétaire uniquement, champs strictement validés et bornés
    //  - users/{uid}.country : format ISO-2 + VERROU (posé une seule fois,
    //    plus jamais modifiable ni supprimable via le client) — le pop-up
    //    de pays est lié au COMPTE, pas à l'appareil
    //  - curricula : pays imposé = préfixe du document, auteur obligatoirement
    //    l'utilisateur connecté, horodatage serveur (anti-falsification)
    //  - Création de compte : champs sensibles verrouillés (premium/role)
    //  - Update user : tous les champs d'abonnement/paiement protégés
    //  - Groupes : validation stricte des messages (anti-XSS/spam)
    //  - Bannissements : admins uniquement (serveur, plus via l'UI)
    //  - Paiements : saspayPendingCheckouts réservé au serveur
    // ═══════════════════════════════════════════════════════════════

    // ─── Fonction helper : est-ce un admin ? ─────────────────────
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ─── Fonction helper : est-ce le propriétaire ? ──────────────
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // ═══════════════════════════════════════════════════════════════
    // USERS + SOUS-COLLECTIONS
    // ═══════════════════════════════════════════════════════════════
    match /users/{userId} {

      // ─── Lecture : propriétaire OU admin ────────────────────────
      allow read: if isOwner(userId) || isAdmin();

      // ─── Création : propriétaire uniquement, profil "étudiant gratuit" imposé
      // 🔒 Empêche de créer un compte déjà premium/admin.
      allow create: if isOwner(userId)
        && request.resource.data.role == 'student'
        && request.resource.data.premium == false
        && request.resource.data.isUnlocked == false
        && request.resource.data.hasDeposited == false
        && request.resource.data.accountStatus == 'active';

      // ─── Update : propriétaire SAUF champs sensibles ────────────
      // 🔒 Les champs d'abonnement et de paiement ne sont modifiables
      // que par le serveur (SDK admin, via les webhooks/API).
      allow update: if isOwner(userId)
        && !(request.resource.data.diff(resource.data).affectedKeys()
              .hasAny([
                'premium',
                'isUnlocked',
                'hasDeposited',
                'role',
                'accountStatus',
                'subscriptionPlan',
                'subscriptionStatus',
                'subscriptionStartDate',
                'subscriptionEndDate',
                'subscriptionPaidAt',
                'saspayTransactionId',
                'saspayReference',
                'saspayAmountPaid',
                'saspayCheckoutReference',
                'saspayCheckoutSessionId',
                'saspayCheckoutStartedAt'
              ]))

      // ✅ v3 — PAYS VERROUILLÉ (choix forcé dans exam/reviseur) :
      //  - format ISO-2 imposé (« NE », « ML », « SN », …)
      //  - posé UNE SEULE fois par le compte ; ensuite, plus AUCUNE
      //    modification ni suppression possible via le client : le garde-fou
      //    serveur garantit « une fois confirmé, c'est fixe à vie » et le
      //    pop-up est bien lié au COMPTE (un nouveau compte sur le même
      //    appareil repasse par le choix de pays).
      //  - countryConfirmedAt devient immuable dès qu'il existe.
        && (!('country' in request.resource.data)
            || (request.resource.data.country is string
                && request.resource.data.country.size() == 2
                && request.resource.data.country.matches('^[A-Z]{2}$')))
        && (!('country' in resource.data)
            || (('country' in request.resource.data)
                && request.resource.data.country == resource.data.country))
        && (!('countryConfirmedAt' in resource.data)
            || (('countryConfirmedAt' in request.resource.data)
                && request.resource.data.countryConfirmedAt == resource.data.countryConfirmedAt));

      // ─── Suppression : admin uniquement ─────────────────────────
      allow delete: if isAdmin();

      // ─── examResults ────────────────────────────────────────────
      match /examResults/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update, delete: if false;
      }

      // ─── revisionSessions ───────────────────────────────────────
      match /revisionSessions/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update, delete: if false;
      }

      // ─── grades ─────────────────────────────────────────────────
      match /grades/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if isOwner(userId);
      }

      // ─── notifications ──────────────────────────────────────────
      match /notifications/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow update: if isOwner(userId);
        allow create, delete: if isAdmin();
      }

      // ─── examCache (écriture serveur uniquement) ────────────────
      match /examCache/{docId} {
        allow read, write: if false;
      }

      // ─── examUsage ──────────────────────────────────────────────
      match /examUsage/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // ─── reviseurUsage ──────────────────────────────────────────
      match /reviseurUsage/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // ─── activeExam ─────────────────────────────────────────────
      match /activeExam/{docId} {
        allow read, write: if isOwner(userId);
      }

      // ─── activeRevision ─────────────────────────────────────────
      match /activeRevision/{docId} {
        allow read, write: if isOwner(userId);
      }

      // ─── progression (v8.0) ─────────────────────────────────────
      // Sync Firebase des progressions de cours (demande propriétaire :
      // « chaque compte doit avoir ses propres données »). Doc unique
      // « course » : readParts (sections lues) + notes + dailyActivity
      // + stats (le CALCUL de progression par chapitre/matière/global).
      // Écritures bornées (anti-abus) ; lecture réservée au propriétaire
      // et à l'admin (console). Suppression : jamais via le client.
      match /progression/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId)
          && (!('readParts' in request.resource.data)
              || (request.resource.data.readParts is list
                  && request.resource.data.readParts.size() <= 8000))
          && (!('notes' in request.resource.data)
              || (request.resource.data.notes is map
                  && request.resource.data.notes.size() <= 800))
          && (!('dailyActivity' in request.resource.data)
              || (request.resource.data.dailyActivity is map
                  && request.resource.data.dailyActivity.size() <= 60))
          && (!('stats' in request.resource.data)
              || request.resource.data.stats is map);
        allow delete: if false;

        // ── Série 🔥 cloud (v6 — P2) : doc unique « streak » —
        // multi-appareils ; champs EXACTS et bornés (un compte tricheur ne
        // peut pas écrire count = 999 999 ; le serveur re-vérifie de toute
        // façon l'activité réelle avant l'essai Premium).
        match /streak {
          allow read: if isOwner(userId) || isAdmin();
          allow create, update: if isOwner(userId)
            && request.resource.data.keys().hasOnly(['count', 'best', 'freeze', 'last'])
            && request.resource.data.count is int
            && request.resource.data.count >= 0
            && request.resource.data.count <= 730
            && request.resource.data.best is int
            && request.resource.data.best >= 0
            && request.resource.data.best <= 730
            && request.resource.data.freeze is int
            && request.resource.data.freeze >= 0
            && request.resource.data.freeze <= 1
            && request.resource.data.last is string
            && request.resource.data.last.matches('^\\d{4}-\\d{2}-\\d{2}$');
          allow delete: if false;
        }
      }

      // ─── favorites ──────────────────────────────────────────────
      match /favorites/{docId} {
        allow read, write: if isOwner(userId);
      }

      // ─── analytics_daily (v5) ───────────────────────────────────
      // Télémétrie locale du tracker client (analytics.js v3) :
      // 1 doc par jour (id = « YYYY-MM-DD ») + sous-collection results
      // (résultats d'examen/révision). Sans règle dédiée, l'écriture
      // client tombait en permission-denied (refus par défaut) et la
      // page admin Analytics restait vide depuis le durcissement v3.
      // Écriture/lecture : propriétaire uniquement. Champs bornés.
      match /analytics_daily/{dateKey} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId)
          && dateKey is string
          && dateKey.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && request.resource.data.keys().hasOnly([
               'date', 'device', 'lastSeenAt',
               'pages', 'features', 'byTimeOfDay', 'byDayOfWeek',
               'contents', 'totalTime', 'sessions', 'resultsCount'
             ])
          && request.resource.data.date == dateKey
          && (!('device' in request.resource.data)
              || (request.resource.data.device is string
                  && request.resource.data.device.size() <= 20))
          && (!('totalTime' in request.resource.data)
              || request.resource.data.totalTime is number)
          && (!('sessions' in request.resource.data)
              || request.resource.data.sessions is number)
          && (!('resultsCount' in request.resource.data)
              || request.resource.data.resultsCount is number)
          && (!('pages' in request.resource.data)
              || (request.resource.data.pages is map
                  && request.resource.data.pages.size() <= 120))
          && (!('features' in request.resource.data)
              || (request.resource.data.features is map
                  && request.resource.data.features.size() <= 80))
          && (!('byTimeOfDay' in request.resource.data)
              || (request.resource.data.byTimeOfDay is map
                  && request.resource.data.byTimeOfDay.size() <= 6))
          && (!('byDayOfWeek' in request.resource.data)
              || (request.resource.data.byDayOfWeek is map
                  && request.resource.data.byDayOfWeek.size() <= 8))
          && (!('contents' in request.resource.data)
              || (request.resource.data.contents is map
                  && request.resource.data.contents.size() <= 60));
        allow delete: if false;

        match /results/{resultId} {
          allow read: if isOwner(userId) || isAdmin();
          allow create: if isOwner(userId)
            && request.resource.data.keys().hasOnly(
                 ['kind', 'subject', 'score', 'total', 'difficulty', 'ts', 'createdAt'])
            && request.resource.data.kind is string
            && request.resource.data.kind.size() <= 40
            && (!('subject' in request.resource.data)
                || (request.resource.data.subject is string
                    && request.resource.data.subject.size() <= 40))
            && request.resource.data.score is number
            && request.resource.data.score >= 0
            && request.resource.data.score <= 1000
            && (!('total' in request.resource.data)
                || (request.resource.data.total is number
                    && request.resource.data.total >= 0
                    && request.resource.data.total <= 1000))
            && (!('difficulty' in request.resource.data)
                || (request.resource.data.difficulty is string
                    && request.resource.data.difficulty.size() <= 20))
            && request.resource.data.ts is number;
          allow update, delete: if false;
        }
      }
    }

    // ═══════════════════════════════════════════════════════════════
    // PAIEMENTS — réservés au serveur (SDK admin)
    // ═══════════════════════════════════════════════════════════════
    match /saspayPendingCheckouts/{docId} {
      allow read, write: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // COLLECTIONS GLOBALES
    // ═══════════════════════════════════════════════════════════════

    // ─── Sujets (cours) : lecture pour tous les connectés ────────
    match /subjects/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ─── Programmes communautaires par pays (v8.9, durcis v3) ─────
    // Demande propriétaire : pour les MATIÈRES LITTÉRAIRES (philosophie,
    // histoire, géographie) qui changent d'un pays à l'autre, les élèves
    // d'un même pays remplissent progressivement leurs chapitres. Chaque
    // chapitre est stocké en mentionnant le pays → tout élève du même
    // pays voit les chapitres déjà listés et la liste se complète.
    // curricula/{ISO}_{matiere}                       = méta
    // curricula/{ISO}_{matiere}/chapters/{slug}       = chapitre
    match /curricula/{key} {
      allow read: if request.auth != null;
      // Méta : 4 champs exactement, pays ISO-2 = préfixe du document,
      // auteur = utilisateur connecté, date = horloge du serveur (v3).
      allow create, update: if request.auth != null
        && key is string
        && key.size() <= 60
        && request.resource.data.keys().hasOnly(['country', 'subject', 'updatedAt', 'updatedBy'])
        && request.resource.data.country is string
        && request.resource.data.country.size() == 2
        && request.resource.data.country.matches('^[A-Z]{2}$')
        && key.split('_')[0] == request.resource.data.country
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 40
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /chapters/{chapterId} {
        allow read: if request.auth != null;
        // Chapitre : titre borné, auteur = lui-même (anti-usurpation)
        allow create: if request.auth != null
          && chapterId is string
          && chapterId.size() >= 1
          && chapterId.size() <= 100
          && request.resource.data.keys().hasOnly(['title', 'order', 'addedBy', 'addedAt'])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.order is string
          && request.resource.data.order.size() <= 120
          && request.resource.data.addedBy == request.auth.uid;
        // Immuables : on ne réécrit pas le chapitre d'un autre
        allow update: if false;
        // Retrait : uniquement ses propres ajouts
        allow delete: if request.auth != null
          && resource.data.addedBy == request.auth.uid;
      }
    }

    // ─── Positions partagées « À proximité » (v4) ──────────────
    // Chaque élève décide d'activer son partage : UN doc positions/{uid}.
    //  - Lecture : tous les connectés (c'est le but : se trouver).
    //  - Écriture : ses SEULES données, champs exacts, valeurs bornées,
    //    horodatage serveur (anti-fausse fraîcheur).
    //  - latitude/longitude déjà ARRONDIES à 3 décimales par le client
    //    (~110 m) : jamais d'adresse précise. Pas de champ libre hormis
    //    pseudo (60) et ville (80).
    //  - Suppression : soi-même (bouton « Arrêter le partage ») ou admin.
    match /positions/{uid} {
      allow read: if request.auth != null;
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(
             ['uid', 'name', 'lat', 'lng', 'accuracy', 'city', 'country', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 60
        && request.resource.data.lat is number
        && request.resource.data.lat >= -90
        && request.resource.data.lat <= 90
        && request.resource.data.lng is number
        && request.resource.data.lng >= -180
        && request.resource.data.lng <= 180
        && request.resource.data.accuracy is number
        && request.resource.data.accuracy >= 0
        && request.resource.data.accuracy <= 100000
        && request.resource.data.city is string
        && request.resource.data.city.size() <= 80
        && (!('country' in request.resource.data)
            || (request.resource.data.country is string
                && request.resource.data.country.size() == 2
                && request.resource.data.country.matches('^[A-Z]{2}$')))
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ─── Avis utilisateurs ────────────────────────────────────────
    match /avis/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        // 🔒 Anti-spam basique : commentaires bornés
        && (!('comment' in request.resource.data)
            || (request.resource.data.comment is string
                && request.resource.data.comment.size() <= 1000));
      allow update, delete: if isAdmin();
    }

    // ─── Groupes (chat) ───────────────────────────────────────────
    match /groups/{groupId} {
      // Métadonnées du groupe : serveur uniquement
      allow read: if request.auth != null;
      allow write: if false;

      // ─── Messages : création validée, immuables, suppression restreinte
      match /messages/{msgId} {
        allow read: if request.auth != null;

        // 🔒 Validation stricte à la création :
        //  - l'auteur est obligatoirement l'utilisateur connecté
        //  - longueurs bornées (anti-spam / anti-XML bomb)
        //  - imageBase64 : data URI image stricte, taille plafonnée (anti-XSS)
        //  - createdAt imposé par le serveur (anti-faux timestamps)
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.userName is string
          && request.resource.data.userName.size() > 0
          && request.resource.data.userName.size() <= 60
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 2000
          && (!('userEmail' in request.resource.data)
              || (request.resource.data.userEmail is string
                  && request.resource.data.userEmail.size() <= 120))
          && (!('userAvatar' in request.resource.data)
              || request.resource.data.userAvatar == null
              || (request.resource.data.userAvatar is string
                  && request.resource.data.userAvatar.size() <= 500000))
          && (!('imageName' in request.resource.data)
              || (request.resource.data.imageName is string
                  && request.resource.data.imageName.size() <= 100))
          && (!('imageBase64' in request.resource.data)
              || (request.resource.data.imageBase64 is string
                  && request.resource.data.imageBase64.size() > 0
                  && request.resource.data.imageBase64.size() <= 900000
                  && request.resource.data.imageBase64.matches(
                      '^data:image/(png|jpe?g|gif|webp);base64,[A-Za-z0-9+/=]+$')))
          && (!('replyTo' in request.resource.data)
              || (request.resource.data.replyTo is map
                  && request.resource.data.replyTo.keys().hasOnly(['id', 'author', 'content', 'type'])
                  && request.resource.data.replyTo.id is string
                  && request.resource.data.replyTo.id.size() <= 128
                  && request.resource.data.replyTo.author is string
                  && request.resource.data.replyTo.author.size() <= 60
                  && request.resource.data.replyTo.content is string
                  && request.resource.data.replyTo.content.size() <= 100))
          && request.resource.data.createdAt == request.time;

        // 🔒 Les messages sont immuables (pas d'édition déguisée par autrui)
        allow update: if false;

        // 🔒 Suppression : son propre message, ou admin
        allow delete: if isAdmin()
          || (request.auth != null && resource.data.userId == request.auth.uid);
      }

      // ─── Bannissements : admins uniquement (serveur-imposé) ─────
      // 🔒 Avant : n'importe quel utilisateur bannissait n'importe qui.
      match /banned/{bannedUserId} {
        allow read: if request.auth != null;
        allow create, update, delete: if isAdmin();
      }

      // ─── Toute autre sous-collection : accès refusé par défaut ──
      match /{otherSub=**} {
        allow read, write: if false;
      }
    }

    // ─── Notifications admin (lecture pour tous) ──────────────────
    match /admin_notifications/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ─── Codes promo : lecture pour connectés ────────────────────
    // ─── Classement hebdomadaire OPT-IN (v6 — P2 rétention) ──────
    // leaderboard/{weekKey}/entries/{uid} — semaine = « YYYY-Www ».
    //  - OPT-IN : l'élève choisit d'apparaître (le retrait supprime son entry).
    //  - Lecture : tous les connectés (c'est le but).
    //  - Écriture : SES SEULES données, champs exacts, points bornés,
    //    horodatage serveur (anti-fausse fraîcheur). Pseudo borné.
    //  - Points (lecture + régularité) calculés par le client sur SES données
    //    locales ; limite connue et assumée : un tricheur ne gonfle que SA
    //    place d'affichage — aucun gain premium n'est lié au classement.
    match /leaderboard/{weekKey} {
      allow read, write: if false;

      match /entries/{entryUid} {
        allow read: if request.auth != null;
        allow create, update: if isOwner(entryUid)
          && weekKey is string
          && weekKey.matches('^\\d{4}-W\\d{2}$')
          && request.resource.data.keys().hasOnly(
               ['uid', 'name', 'points', 'streak', 'updatedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 60
          && request.resource.data.points is int
          && request.resource.data.points >= 0
          && request.resource.data.points <= 100000
          && request.resource.data.streak is int
          && request.resource.data.streak >= 0
          && request.resource.data.streak <= 730
          && request.resource.data.updatedAt == request.time;
        allow delete: if isOwner(entryUid) || isAdmin();
      }
    }

    // ─── Cache IA partagé (v6) : SERVEUR uniquement ──────────────
    // Une même section générée UNE fois pour tous les élèves
    // (api/progress.js). Le SDK admin contourne ces règles.
    match /ai_cache/{docId} {
      allow read, write: if false;
    }

    // ─── Pool d'exercices « Test moi » : SERVEUR uniquement ─────
    // (fermé par défaut, rendu explicite avec le pool-first v8.25)
    match /examPool/{docId} {
      allow read, write: if false;
    }

    match /promoCodes/{code} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ─── Config : lecture pour admins ─────────────────────────────
    match /config/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ─── Logs admin : lecture pour admins ─────────────────────────
    match /adminLogs/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
