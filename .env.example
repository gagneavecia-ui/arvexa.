# Exemple uniquement. Ne jamais mettre de vraies valeurs ici.
# Configurer ces variables dans Vercel > Settings > Environment Variables > Production.

FIREBASE_ADMIN_CREDENTIALS={"type":"service_account",...}
FIREBASE_WEB_API_KEY=your_firebase_web_api_key
GROQ_API_KEY=your_groq_key
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_MODEL=openai/gpt-oss-120b
MISTRAL_API_KEY=your_mistral_key
MISTRAL_MODEL=mistral-large-latest
APP_ORIGIN=https://your-domain.vercel.app
EXVA_LOCAL_FALLBACK=false
# Ne pas definir EXVA_LOCAL_FALLBACK en Production.
