rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════
    // RÈGLES ARVEXA SCHOOL
    // Version : 2026-09-23
    // ═══════════════════════════════════════════════════════════════

    // ─── Fonction helper : est-ce un admin ? ─────────────────────
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ─── Fonction helper : est-ce le propriétaire ? ──────────────
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // ═══════════════════════════════════════════════════════════════
    // USERS + SOUS-COLLECTIONS
    // ═══════════════════════════════════════════════════════════════
    match /users/{userId} {

      // ─── Lecture : propriétaire OU admin ────────────────────────
      allow read: if isOwner(userId) || isAdmin();

      // ─── Création : propriétaire uniquement ─────────────────────
      allow create: if isOwner(userId);

      // ─── Update : propriétaire SAUF champs sensibles ────────────
      allow update: if isOwner(userId)
        && !(request.resource.data.diff(resource.data).affectedKeys()
              .hasAny([
                'premium',
                'isUnlocked',
                'hasDeposited',
                'role',
                'accountStatus'
              ]));

      // ─── Suppression : admin uniquement ─────────────────────────
      allow delete: if isAdmin();

      // ─── examResults ────────────────────────────────────────────
      match /examResults/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update, delete: if false;
      }

      // ─── revisionSessions ───────────────────────────────────────
      match /revisionSessions/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update, delete: if false;
      }

      // ─── grades ─────────────────────────────────────────────────
      match /grades/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if isOwner(userId);
      }

      // ─── notifications ──────────────────────────────────────────
      match /notifications/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow update: if isOwner(userId);
        allow create, delete: if isAdmin();
      }

      // ─── examCache (écriture serveur uniquement) ────────────────
      match /examCache/{docId} {
        allow read, write: if false;
      }

      // ─── examUsage ──────────────────────────────────────────────
      match /examUsage/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // ─── reviseurUsage ──────────────────────────────────────────
      match /reviseurUsage/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // ─── activeExam ─────────────────────────────────────────────
      match /activeExam/{docId} {
        allow read, write: if isOwner(userId);
      }

      // ─── activeRevision ─────────────────────────────────────────
      match /activeRevision/{docId} {
        allow read, write: if isOwner(userId);
      }

      // ─── favorites ──────────────────────────────────────────────
      match /favorites/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ═══════════════════════════════════════════════════════════════
    // COLLECTIONS GLOBALES
    // ═══════════════════════════════════════════════════════════════

    // ─── Sujets (cours) : lecture pour tous les connectés ────────
    match /subjects/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ─── Avis utilisateurs ────────────────────────────────────────
    match /avis/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // ─── Groupes (chat) ───────────────────────────────────────────
    match /groups/{groupId}/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ─── Notifications admin (lecture pour tous) ──────────────────
    match /admin_notifications/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ─── Codes promo : lecture pour connectés ────────────────────
    match /promoCodes/{code} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ─── Config : lecture pour admins ─────────────────────────────
    match /config/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ─── Logs admin : lecture pour admins ─────────────────────────
    match /adminLogs/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
